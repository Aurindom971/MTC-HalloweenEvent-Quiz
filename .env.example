# ==============================================================================
# MTC Spook-A-Thon 2026 — Vercel & Production Environment Configuration
# ==============================================================================

# Admin & Judges Board Password
# Set your secure master password for accessing /admin and /judges.
# You can set a single password or multiple comma-separated passwords (e.g. for admin and judges):
ADMIN_PASSWORD=your_secure_admin_password_here
# Optional multiple passwords:
# ADMIN_PASSWORDS=lead_admin_pass,judge_pass_alpha,judge_pass_beta

# Supabase Database Credentials
# Obtain these from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
#
# 1. Project URL:
SUPABASE_URL=https://fnubekbfadspsctsmdwl.supabase.co
# Also accepts NEXT_PUBLIC_SUPABASE_URL=...

# 2. Server-Side Service Role Key (REQUIRED FOR FULL ACCESS):
# In Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# IMPORTANT: The service_role key is used by serverless backend functions (api/*) to bypass
# PostgreSQL Row Level Security (RLS) so the admin panel can read registrations and record grades.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Client-Side Anon / Publishable Key (Optional, for public client features):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Session Security Secret
# Any random 32+ character string used to cryptographically sign HTTP-only session cookies.
SESSION_SECRET=mtc_spookathon_secure_cookie_signing_secret_2026_xyz

